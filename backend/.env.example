CORS_ORIGINS=http://localhost:xxxx
SESSION_TTL_SECONDS=3600
MAX_UPLOAD_MB=50
GROQ_API_KEY=your_groq_api_key_here
QDRANT_URL=http://localhost:xxxx
AUTH_SECRET=your_auth_secret_here
DATABASE_URL=your_database_url_here

# Embedding provider settings (set EMBEDDING_PROVIDER to 'gemini' or 'ollama')
EMBEDDING_PROVIDER=gemini

# Gemini embedding settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini model

# Ollama embedding settings
OLLAMA_URL=http://localhost:xxxxx
OLLAMA_EMBEDDING_MODEL=all-minilm

# Vector dimension (must match configured provider model: 768 for gemini-embedding-2, 384 for all-minilm)
EMBEDDING_DIMENSION=768
